rules_version = '2';

/* =========================================================
   Reglas de seguridad de Firestore — Appliance Solutions 901

   Idea central:
   - Un visitante anónimo del sitio puede CREAR una solicitud y nada más.
     No puede leerlas, ni listarlas, ni modificarlas, ni borrarlas.
   - Solo un usuario autenticado (el dueño, desde /admin) administra.
   - Todo lo que no esté declarado aquí queda bloqueado.

   Importante: los campos opcionales se leen con .get(campo, valor por
   defecto). Así, si el formulario deja de enviar alguno, la regla NO
   revienta y sigue aceptando la solicitud. Antes, validar un campo que
   no llegaba hacía fallar toda la regla y se rechazaba el guardado.

   Cómo aplicarlas: Firebase Console -> Firestore Database -> Rules,
   borrar todo, pegar esto y pulsar Publicar.
   ========================================================= */
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null;
    }

    function opcional(datos, campo, maximo) {
      return datos.get(campo, '') is string && datos.get(campo, '').size() <= maximo;
    }

    function obligatorio(datos, campo, maximo) {
      return datos.get(campo, '') is string
             && datos.get(campo, '').size() > 0
             && datos.get(campo, '').size() <= maximo;
    }

    match /leads/{leadId} {

      // El formulario del sitio: solo crear, con la forma esperada
      allow create: if request.resource.data.keys().hasOnly([
                         'nombre', 'telefono', 'email', 'electrodomestico',
                         'mensaje', 'marcaModelo', 'direccion',
                         'zona', 'idioma', 'origen',
                         'estado', 'notas', 'pagoAdelantado', 'createdAt'
                       ])
                    && obligatorio(request.resource.data, 'nombre', 120)
                    && obligatorio(request.resource.data, 'telefono', 40)
                    && obligatorio(request.resource.data, 'direccion', 200)
                    && opcional(request.resource.data, 'email', 160)
                    && opcional(request.resource.data, 'electrodomestico', 60)
                    && opcional(request.resource.data, 'mensaje', 2000)
                    && opcional(request.resource.data, 'marcaModelo', 120)
                    && opcional(request.resource.data, 'zona', 60)
                    && request.resource.data.get('idioma', 'en') in ['es', 'en']
                    && opcional(request.resource.data, 'origen', 40)
                    // el visitante no elige el estado ni se autoasigna nada
                    && request.resource.data.get('estado', '') == 'nueva'
                    && request.resource.data.get('notas', '') == ''
                    && request.resource.data.get('pagoAdelantado', true) == false
                    && request.resource.data.createdAt == request.time;

      // Leer y administrar: solo el dueño autenticado
      allow read: if esAdmin();

      // Al actualizar no se puede reescribir la solicitud original:
      // el nombre, el teléfono y la fecha quedan como llegaron.
      allow update: if esAdmin()
                    && request.resource.data.nombre == resource.data.nombre
                    && request.resource.data.telefono == resource.data.telefono
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.get('estado', '') in
                       ['nueva', 'contactada', 'agendada', 'terminada', 'perdida']
                    && opcional(request.resource.data, 'notas', 4000)
                    && opcional(request.resource.data, 'direccion', 200)
                    && opcional(request.resource.data, 'marcaModelo', 120)
                    && request.resource.data.get('pagoAdelantado', false) is bool;

      allow delete: if esAdmin();
    }

    // Cualquier otra colección queda cerrada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
